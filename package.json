{
  "name": "moss-proxyswitch",
  "description": "Local proxy and backend environment switcher",
  "author": "Moss",
  "private": true,
  "license": "MIT",
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "download-caddy": "node scripts/download-caddy.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "ui:check": "node scripts/shadcn.mjs check",
    "ui:diff": "node scripts/shadcn.mjs diff",
    "ui:update": "node scripts/shadcn.mjs update",
    "ui:add": "node scripts/shadcn.mjs add",
    "preview": "vite preview",
    "release:notes": "node scripts/release-notes.mjs",
    "release:prepare": "node scripts/prepare-version.mjs",
    "release:github": "node scripts/github-release.mjs",
    "check:public": "node scripts/check-public-content.mjs --history",
    "licenses:generate": "node scripts/dependency-licenses.mjs",
    "tauri": "tauri",
    "tauri:dev": "pnpm download-caddy && pnpm tauri dev",
    "tauri:build": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "class-variance-authority": "^0.7.0",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20.10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "vite": "^6.4.4"
  }
}
