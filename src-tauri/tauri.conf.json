{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Moss ProxySwitch",
  "version": "0.2.0",
  "identifier": "com.caddy-proxy-tools.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:13000",
    "beforeDevCommand": "pnpm download-caddy && pnpm dev",
    "beforeBuildCommand": "pnpm release:notes && pnpm download-caddy && pnpm licenses:generate && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Moss ProxySwitch",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "generalAutofillEnabled": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": false,
      "tooltip": "Moss ProxySwitch"
    },
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:13000 ws://localhost:13000"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Moss",
    "shortDescription": "固定入口，随时切换后端环境",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/caddy"
    ],
    "resources": {
      "../CHANGELOG.md": "CHANGELOG.md",
      "../docs/releases/RELEASE_NOTES.md": "RELEASE_NOTES.md",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBMzIzNjYxQzREMDMwRkYKUldUL01OREVZVFl5Nm1ManJLeG5VanBOUlBKUWxtNjFiYUlHUU9UcUNMaTBjY2ZvMWNFY3VCcCsK",
      "endpoints": [
        "https://github.com/MosYCo/ProxySwitch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
