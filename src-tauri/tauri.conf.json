{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Caddy Proxy Tools",
  "version": "2.0.0",
  "identifier": "com.caddy-proxy-tools.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:12000",
    "beforeDevCommand": "pnpm download-caddy && pnpm dev",
    "beforeBuildCommand": "pnpm download-caddy && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Caddy Proxy Tools",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Caddy Proxy Tools"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/caddy"],
    "resources": []
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "binaries/caddy",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}
